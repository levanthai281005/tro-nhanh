# Chép thành `.env` ở cùng thư mục. Giá trị dưới đây khớp Postgres trong `compose.yaml`.

NODE_ENV=development
PORT=8089

# Ứng dụng kết nối qua chuỗi này. Trên Supabase: bộ gộp kết nối Supavisor chế độ transaction
# (cổng 6543). Ở máy local không có bộ gộp nên trùng DIRECT_URL.
DATABASE_URL=postgresql://tronhanh:tronhanh@localhost:5432/tronhanh

# Migration kết nối qua chuỗi này. Trên Supabase: kết nối trực tiếp (cổng 5432) — hoặc session
# pooler cổng 5432 nếu mạng chỉ có IPv4, vì kết nối trực tiếp chỉ chạy trên IPv6.
# BẮT BUỘC cùng user với DATABASE_URL — xem docs/DEVELOPMENT_SETUP.md, mục cơ sở dữ liệu.
DIRECT_URL=postgresql://tronhanh:tronhanh@localhost:5432/tronhanh
